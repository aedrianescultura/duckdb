# name: test/sql/delete/test_truncate.test
# description: Test truncate (dedicated statement)
# group: [delete]

statement ok
CREATE TABLE a(i INTEGER);

statement ok
INSERT INTO a VALUES (42);

# TRUNCATE empties the table (regression guard; D1 "returns nothing" is verified at the binder level)
statement ok
TRUNCATE TABLE a

query I
SELECT COUNT(*) FROM a;
----
0

statement ok
INSERT INTO a VALUES (42);

# optional TABLE keyword form
statement ok
TRUNCATE a

query I
SELECT COUNT(*) FROM a;
----
0

statement ok
INSERT INTO a VALUES (42);

# rollback restores rows
statement ok
BEGIN TRANSACTION

statement ok
TRUNCATE a

query I
SELECT COUNT(*) FROM a;
----
0

statement ok
ROLLBACK

query I
SELECT COUNT(*) FROM a;
----
1

# truncating a non-existent table errors
statement error
TRUNCATE does_not_exist
----
<REGEX>:.*does_not_exist.*
